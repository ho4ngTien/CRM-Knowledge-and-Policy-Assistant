# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Host Port Customization (Docker Compose local override) ──────────────────
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80

# ── Database (PostgreSQL + pgvector) ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ckpa:ckpa_pass@localhost:5432/ckpa_db
DATABASE_POOL_SIZE=10

# ── Redis (cache / rate-limit) ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Chọn: openai | azure | local | mock — cần đánh giá retention/privacy trước khi prod
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_MODEL_NAME=
LLM_MAX_INPUT_TOKENS=6000
LLM_MAX_OUTPUT_TOKENS=900
LLM_MAX_CALLS_PER_MONTH=2000
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_ALLOW_TRAINING=false
LLM_ZERO_DATA_RETENTION=true
LLM_TELEMETRY_ENABLED=false

# ── S4 Assistant Versioning ──────────────────────────────────────────────────
CONFIG_VERSION=1.0.0
PROMPT_VERSION=v1.0

# ── Embedding ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ── Identity / Auth ──────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Import Service ───────────────────────────────────────────────────────────
IMPORT_OUTPUT_DIR=data/output
IMPORT_MAX_ROWS_PER_BATCH=500
IMPORT_SNAPSHOT_STALENESS_HOURS=25
ENABLE_O1_CONTEXT_IMPORT=false

# --- RFP / SRS Runtime Bounds (Base Scope Only) ---
APP_TIMEZONE=Asia/Ho_Chi_Minh
ENABLE_ANSWER_STREAMING=false
ANSWER_SYSTEM_PROMPT_PATH=prompts/answer_system_vi.txt
LLM_MAX_CALLS_PER_PACKAGE=2
ANSWER_MAX_PASSAGES=8
ANSWER_MAX_PACKAGES_PER_MONTH=1000
PASSAGE_MAX_CHARS=6000
CORPUS_MAX_DOCUMENTS=30
CORPUS_MAX_PASSAGES=300
CORPUS_MAX_CRITICAL_FIELDS=50
CACHE_WITHDRAWAL_MAX_SECONDS=300
OPS_LATENCY_P95_SECONDS=25
EMERGENCY_DISABLE_CACHE_KEY=ckpa:emergency_disable
PILOT_MAX_NAMED_USERS=20
PILOT_MAX_CONCURRENT_SESSIONS=5
SUPPORT_HOURS_START=08:00
SUPPORT_HOURS_END=17:00

# ── Worker / Scheduler ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
